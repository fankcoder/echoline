{
  "name": "echoline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"node --env-file-if-exists=.env --import tsx --watch server/index.ts\" \"vite\"",
    "dev:e2e": "concurrently -k -n api,web -c green,cyan \"PORT=4174 ECHOLINE_DB=:memory: node --import tsx server/index.ts\" \"VITE_API_PORT=4174 vite --port 5174 --strictPort\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import tsx server/index.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dictionary:install": "node scripts/install-ecdict.mjs",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/static": "8.1.1",
    "fastify": "5.6.1",
    "hls.js": "1.5.18",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.9.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.13",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.1",
    "eslint": "9.38.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "jsdom": "27.0.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "5.4.21",
    "vitest": "3.2.4"
  }
}
