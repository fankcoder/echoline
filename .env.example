# EchoLine 默认只监听本机。如需局域网访问，请明确改为 0.0.0.0，并自行配置防火墙。
HOST=127.0.0.1
PORT=4173
ECHOLINE_DB=./data/echoline.db

# 应用挂在域名根路径时保持 /；若通过 Nginx 部署在 https://example.com/learn，分别改为 /learn/ 和 /learn。
VITE_BASE_PATH=/
APP_BASE_PATH=/

# 免费逐句翻译。mymemory 无需 Key；libretranslate 可指向用户自建服务。
TRANSLATION_PROVIDER=mymemory
TRANSLATION_TIMEOUT_MS=15000
TRANSLATION_REQUEST_INTERVAL_MS=500
MYMEMORY_EMAIL=
# LIBRETRANSLATE_URL=http://127.0.0.1:5000
# LIBRETRANSLATE_API_KEY=

# 运行 npm run dictionary:install 后默认使用此数据库；自定义位置时再修改。
ECDICT_PATH=./data/dictionaries/ecdict.db
LOG_LEVEL=info

# 通过 HTTPS 域名反向代理部署时，填写浏览器访问使用的站点来源（可用逗号分隔多个来源）。
# PUBLIC_ORIGIN=https://anhao.net

# 可选：GitHub / Google 登录。密钥仅保存在服务器 .env，绝不能写入 VITE_ 环境变量或提交 Git。
# GitHub 回调地址：${PUBLIC_ORIGIN}${APP_BASE_PATH}/api/auth/github/callback
# Google 回调地址：${PUBLIC_ORIGIN}${APP_BASE_PATH}/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 从旧版（无账户）服务升级时，可临时填写旧数据所属人的注册邮箱；首次登录时会将旧服务器生词本安全迁入该账户。
# LEGACY_VOCABULARY_OWNER_EMAIL=you@example.com
