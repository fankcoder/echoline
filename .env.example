# EchoLine 默认只监听本机。如需局域网访问，请明确改为 0.0.0.0，并自行配置防火墙。
HOST=127.0.0.1
PORT=4173
ECHOLINE_DB=./data/echoline.db

# OpenAI 兼容翻译接口。未配置 Key 时，英文字幕仍可正常使用。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=45000
OPENAI_TRANSLATION_BATCH_SIZE=10

# 可选：ECDICT SQLite 数据库路径。未配置时使用内置常用词和 Free Dictionary 补充。
# ECDICT_PATH=/absolute/path/to/ecdict.db
LOG_LEVEL=info
