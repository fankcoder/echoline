# EchoLine 默认只监听本机。如需局域网访问，请明确改为 0.0.0.0，并自行配置防火墙。
HOST=127.0.0.1
PORT=4173
ECHOLINE_DB=./data/echoline.db

# OpenAI 兼容翻译接口。未配置 Key 时，英文字幕仍可正常使用。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# auto 会按模型自动选择 Responses 或 Chat Completions；也可显式填写 responses/chat-completions。
OPENAI_API_PROTOCOL=auto
OPENAI_TIMEOUT_MS=45000
OPENAI_TRANSLATION_BATCH_SIZE=10
# Responses 模式为提高兼容性会自动将单批上限收紧到 3 句。
OPENAI_REQUEST_INTERVAL_MS=2500

# 运行 npm run dictionary:install 后默认使用此数据库；自定义位置时再修改。
ECDICT_PATH=./data/dictionaries/ecdict.db
LOG_LEVEL=info
